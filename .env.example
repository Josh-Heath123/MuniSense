# Local settings for MuniSense. Copy to .env (git-ignored) and change what you need.
# Every value has a working local default in docker-compose.yml, so .env is optional for now.
# These are local development values only; production settings are decided at P9/P10.

# PostgreSQL (docker compose up -d db)
MUNISENSE_DB_USER=munisense
MUNISENSE_DB_PASSWORD=munisense-local-only
MUNISENSE_DB_NAME=munisense_dev
MUNISENSE_TEST_DB_NAME=munisense_test
# The two database names must differ. Both take effect only when the volume is first created.
# Host port, bound to 127.0.0.1 only. Change it if 5432 is already in use.
MUNISENSE_DB_PORT=5432

# Connection URLs (P2-3). Every one has the same default in src/munisense/platform/settings.py,
# used only while MUNISENSE_ENVIRONMENT is local (the default). Local means a loopback host
# (localhost, 127.0.0.1 or ::1). Outside a local environment every URL must be set, the
# published passwords are refused, and sslmode=verify-full is required.
# Every connection gets gssencmode=disable and require_auth=scram-sha-256; service= lookups
# and libpq PG* environment variables (PGHOST, PGPASSWORD and the rest) are refused.
MUNISENSE_ENVIRONMENT=local
# The superuser above: used only by `uv run poe db-bootstrap` and the bootstrap's own tests.
MUNISENSE_ADMIN_DATABASE_URL=postgresql://munisense:munisense-local-only@localhost:5432/munisense_dev
# The application role (SELECT only) and the migration role (owns the munisense schema).
MUNISENSE_DATABASE_URL=postgresql://munisense_app:munisense-app-local-only@localhost:5432/munisense_dev
MUNISENSE_MIGRATION_DATABASE_URL=postgresql://munisense_migration:munisense-migration-local-only@localhost:5432/munisense_dev
MUNISENSE_TEST_DATABASE_URL=postgresql://munisense_app:munisense-app-local-only@localhost:5432/munisense_test
MUNISENSE_TEST_MIGRATION_DATABASE_URL=postgresql://munisense_migration:munisense-migration-local-only@localhost:5432/munisense_test
